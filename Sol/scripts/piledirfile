#!/bin/bash
# Description: Compiles all project files (INCLUDING hidden dotfiles) into an AI text file on the Desktop.

TARGET_DIR=$(pwd)
OUTPUT="$HOME/Desktop/fulldirFile.txt"

# Reset the output file cleanly
> "$OUTPUT"

echo "===============================================================================" > "$OUTPUT"
echo "DIRECTORY INDEX / TREE"
echo "Base Directory: $TARGET_DIR" >> "$OUTPUT"
echo "===============================================================================" >> "$OUTPUT"

# Generate a visual layout tree that shows hidden files but ignores deep system junk
if command -v tree &> /dev/null; then
    tree -a -I '.git|node_modules|.DS_Store' "$TARGET_DIR" >> "$OUTPUT"
else
    cd "$TARGET_DIR" && find . -not -path '*/.git*' -not -path '*node_modules*' -not -name '.DS_Store' >> "$OUTPUT"
fi

echo -e "\n===============================================================================" >> "$OUTPUT"
echo "FILE CONTENTS" >> "$OUTPUT"
echo "===============================================================================" >> "$OUTPUT"

# Scan through all files, including dotfiles
find "$TARGET_DIR" -type f | while read -r file; do
    # HARD FILTER: Never scrape git backend histories, node packages, or Mac desktop caches
    [[ "$file" == *"/.git/"* ]] && continue
    [[ "$file" == *"/node_modules/"* ]] && continue
    [[ "$file" == *"/.DS_Store"* ]] && continue
    [[ "$file" == "$OUTPUT" ]] && continue

    # Ensure it's readable text so we don't dump corrupted image/binary data into your context
    if file "$file" | grep -qE 'text|empty|JSON|XML|YAML'; then
        echo -e "\n-------------------------------------------------------------------------------" >> "$OUTPUT"
        echo "FILE: ${file#$TARGET_DIR/}" >> "$OUTPUT"
        echo "-------------------------------------------------------------------------------" >> "$OUTPUT"
        cat "$file" >> "$OUTPUT"
    fi
done

echo "🚀 Success! Whole directory (including dotfiles) compiled to Desktop: fulldirWTags.txt"
